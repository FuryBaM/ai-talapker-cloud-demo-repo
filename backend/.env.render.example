APP_ENV=demo
APP_CONFIG_FILE=configs/app.cloud.yaml

LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter

OPENROUTER_API_KEY=PUT_OPENROUTER_API_KEY_HERE
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_HTTP_REFERER=https://ai-talapker-demo.onrender.com
OPENROUTER_APP_TITLE=AI-Talapker Demo

QDRANT_URL=https://PUT-YOUR-QDRANT-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=PUT_QDRANT_API_KEY_HERE
QDRANT_COLLECTION=ai_talapker_openrouter_1536
QDRANT_VECTOR_NAME=

ADMIN_JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET
APP_CORS_ORIGINS=https://n8n.kstu.kz,https://PUT-FRONTEND.onrender.com
