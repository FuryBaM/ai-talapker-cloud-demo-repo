APP_ENV=demo
APP_CONFIG_FILE=configs/app.cloud.yaml

# Full cloud LangGraph mode: do not rebuild the remote Qdrant collection on Render.
# APP_DISABLE_LOCAL_MODEL_LOAD only suppresses heavy local GGUF/transformers models;
# FastEmbed/OpenRouter still load and are required for retrieval/generation.
APP_USE_EXISTING_QDRANT_INDEX=1
APP_DISABLE_LOCAL_MODEL_LOAD=1
# Emergency smoke-test only; do not enable for real retrieval.
APP_DISABLE_ALL_MODEL_LOAD=0

LLM_PROVIDER=openrouter
APP_GENERATION_BACKEND=openrouter
EMBEDDING_PROVIDER=fastembed
APP_EMBEDDING_BACKEND=fastembed

OPENROUTER_API_KEY=PUT_OPENROUTER_API_KEY_HERE
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_HTTP_REFERER=https://YOUR-BACKEND.onrender.com
OPENROUTER_APP_TITLE=AI-Talapker Demo

FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_DIMENSIONS=384
FASTEMBED_CACHE_DIR=models/fastembed
FASTEMBED_THREADS=1
FASTEMBED_BATCH_SIZE=16

QDRANT_URL=https://PUT-YOUR-QDRANT-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=PUT_QDRANT_API_KEY_HERE
QDRANT_COLLECTION=ai_talapker_fastembed_384
QDRANT_VECTOR_NAME=

ADMIN_JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET
ADMIN_ALLOW_CONFIG_BOOTSTRAP=1
ADMIN_USERNAME=main_admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
AUTH_DB_PATH=/tmp/auth.db

APP_CORS_ORIGINS=https://n8n.kstu.kz,https://PUT-FRONTEND.onrender.com
