# Copy to .env.local and change values before LAN or Docker use.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=

# Optional legacy bootstrap. Keep disabled unless migrating an empty auth DB.
ADMIN_ALLOW_CONFIG_BOOTSTRAP=0
ADMIN_USERNAME=
ADMIN_PASSWORD=

APP_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
APP_MAX_UPLOAD_BYTES=20971520
REDIS_URL=redis://127.0.0.1:6379/0

# OCR for PDF/JPG/PNG uploads. Install Tesseract OCR separately.
APP_OCR_LANG=rus+kaz+eng
APP_OCR_PDF_ZOOM=2.0
APP_OCR_FORCE=0
# Set 0 if OCR text should create DOCX only and never generate XLSX tables.
APP_OCR_EXTRACT_TABLES=1
APP_OCR_TABLE_MIN_ROWS=3
# Windows example: APP_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
APP_TESSERACT_CMD=

# Config selection. Default project runtime is GGUF.
APP_CONFIG_FILE=configs/app.gguf.yaml

# Session memory
APP_MEMORY_ENABLED=1
APP_MEMORY_SUMMARY_EVERY_N=8
APP_MEMORY_RECENT_RAW_LIMIT=12
APP_MEMORY_TOP_K=4
APP_MEMORY_MIN_SCORE=0.22
APP_MEMORY_SUMMARY_MAX_TOKENS=260
APP_MEMORY_MAX_RAW_MESSAGES=120

# Cloud/demo provider factory mode. Copy .env.render.example for Render.
# These aliases are equivalent to APP_GENERATION_BACKEND / APP_EMBEDDING_BACKEND.
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
# LLM_PROVIDER=openrouter
# EMBEDDING_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openrouter/free
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIMENSIONS=1536
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ai_talapker_openrouter_1536
# QDRANT_VECTOR_NAME=
